#!/usr/bin/env python3
"""Prox-Kiox: renova o ticket da PVE no perfil do Firefox, antes de arrancar o kiosk.

Porque é preciso: o cliente web da PVE mostra a árvore e os botões com um token no
localStorage, mas o `Proxmox.UserName` e a vista principal vêm do cookie
`PVEAuthCookie`, que o servidor injeta no HTML. Sem cookie, o painel fica vazio.
Como o ticket dura 2 h, é renovado a cada arranque do kiosk; o token API (que não
expira) fica no localStorage e mantém as chamadas à API vivas depois disso.

Corre com o Firefox FECHADO (o wrapper mata-o antes), por isso escrever na
`cookies.sqlite` do perfil é seguro — não há cache em memória a sobrepor-se.

Se faltar a password ou o token (autologin não configurado), sai em silêncio com
código 0: o kiosk arranca na mesma e mostra o login normal.
"""
import glob
import json
import os
import sqlite3
import ssl
import sys
import time
import urllib.parse
import urllib.request

BASE = "https://127.0.0.1:8006"
CONF = "/etc/prox-kiox/config"
PASSF = "/etc/prox-kiox/kiosk-pass"
HOST = "127.0.0.1"


def ler(caminho, default=""):
    try:
        with open(caminho) as fh:
            return fh.read().strip()
    except OSError:
        return default


def conf() -> dict:
    d = {"user": "kiosk@pve", "tokenid": "panel"}
    for linha in ler(CONF).splitlines():
        if "=" in linha and not linha.strip().startswith("#"):
            k, v = linha.split("=", 1)
            d[k.strip()] = v.strip()
    return d


def ticket(user, password):
    data = urllib.parse.urlencode({"username": user, "password": password}).encode()
    try:
        ctx = ssl.create_default_context(cafile="/etc/pve/pve-root-ca.pem")
    except (OSError, ssl.SSLError):
        # Sem CA local (nó antes de /etc/pve existir); o destino é 127.0.0.1.
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
    req = urllib.request.Request(BASE + "/api2/json/access/ticket", data=data)
    with urllib.request.urlopen(req, context=ctx, timeout=20) as r:
        return json.load(r)["data"]["ticket"]


def escrever_cookie(db, valor, validade):
    con = sqlite3.connect(db, timeout=10)
    try:
        con.execute("delete from moz_cookies where host=? and name='PVEAuthCookie'",
                    (HOST,))
        agora = int(time.time() * 1000)
        con.execute(
            "insert into moz_cookies"
            " (originAttributes, name, value, host, path, expiry, lastAccessed,"
            "  creationTime, isSecure, isHttpOnly, inBrowserElement, sameSite)"
            " values ('', 'PVEAuthCookie', ?, ?, '/', ?, ?, ?, 1, 0, 0, 1)",
            (valor, HOST, validade, agora, agora),
        )
        con.commit()
        return con.total_changes
    finally:
        con.close()


def main():
    if not os.path.exists(PASSF):
        print("autologin nao configurado (sem %s); kiosk arranca com login normal" % PASSF)
        return 0

    c = conf()
    pw = ler(PASSF)
    try:
        t = ticket(c["user"], pw)
    except Exception as e:  # rede, senha errada, pveproxy ainda a subir
        print("aviso: nao consegui obter ticket (%s); segue com login normal" % e)
        return 0

    # O ticket da PVE vale 2 h; o cookie fica com a mesma validade.
    validade = int(time.time() * 1000) + 7000 * 1000
    perfis = glob.glob("/root/.mozilla/firefox/*.default-esr")
    if not perfis:
        print("aviso: sem perfil do Firefox; nada a fazer")
        return 0
    for perfil in perfis:
        db = os.path.join(perfil, "cookies.sqlite")
        if not os.path.exists(db):
            print("aviso: %s nao existe" % db)
            continue
        escrever_cookie(db, t, validade)
        print("cookie PVEAuthCookie renovado em %s" % db)
    return 0


if __name__ == "__main__":
    sys.exit(main())
