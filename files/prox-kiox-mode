#!/bin/bash
# Troca o modo do Prox-Kiox e reinicia o serviço.
#   prox-kiox-mode            -> mostra o modo atual
#   prox-kiox-mode window     -> janela do Firefox com abas (omissão)
#   prox-kiox-mode kiosk      -> ecrã inteiro sem barras
set -u
CONF=/etc/default/prox-kiox

atual() {
    local m="window"
    [ -r "$CONF" ] && . "$CONF" && m="${PROX_KIOX_MODE:-window}"
    echo "$m"
}

case "${1:-status}" in
    status|"")
        echo "modo atual: $(atual)"
        echo "serviço: $(systemctl is-active prox-kiox.service 2>/dev/null)"
        ;;
    window|kiosk)
        [ "$EUID" -eq 0 ] || { echo "ERRO: precisa de root" >&2; exit 1; }
        printf '# Modo do Prox-Kiox: window (janela com abas) ou kiosk (ecrã inteiro)\nPROX_KIOX_MODE=%s\n' "$1" > "$CONF"
        echo "modo -> $1"
        systemctl restart prox-kiox.service && echo "serviço reiniciado"
        ;;
    *)
        echo "uso: prox-kiox-mode [window|kiosk|status]" >&2
        exit 1
        ;;
esac
