#!/bin/bash
# Prox-Kiox (Wayland): arranca cage + Firefox ESR sobre a PVE web UI.
# Corre como serviço systemd (prox-kiox.service). Sem X11, logo sem I/O ports
# (não depende de lockdown=none no kernel).
#
# Modo de arranque em /etc/default/prox-kiox (PROX_KIOX_MODE):
#   window (omissão) -> janela normal do Firefox, com barra de abas/menus
#   kiosk            -> ecrã inteiro sem barras (--kiosk), só a UI da PVE
# Trocar: `prox-kiox-mode kiosk` / `prox-kiox-mode window` (ou editar o ficheiro
# e `systemctl restart prox-kiox`).
set -u

PROX_KIOX_MODE="window"
PROX_KIOX_IDLE="0"
[ -r /etc/default/prox-kiox ] && . /etc/default/prox-kiox
export PROX_KIOX_IDLE

URL="${PROX_KIOX_URL:-https://127.0.0.1:8006}"

case "${PROX_KIOX_MODE:-window}" in
    kiosk)  ARGS="--kiosk" ;;
    *)      ARGS="--new-window" ;;
esac

# Um firefox órfão deixa o perfil bloqueado e abre o diálogo "already running".
pkill -x firefox-esr 2>/dev/null && sleep 1

# Autologin (opcional): se estiver configurado, renova o ticket da PVE no perfil
# antes de o Firefox abrir. Sem isto, o kiosk mostra o formulário de login.
# O Firefox está fechado neste instante, logo escrever na cookies.sqlite é seguro.
/usr/local/bin/prox-kiox-login 2>/dev/null || true

# Liberta o tty1 (consola de texto da PVE) só no momento em que o kiosk arranca;
# num nó sem monitor o getty nunca é tocado.
systemctl stop getty@tty1.service 2>/dev/null

# Ecrã: apaga o monitor por DDC/CI depois de PROX_KIOX_IDLE segundos sem input
# (300 por omissão) e acorda com a primeira tecla/rato. Arranca em paralelo,
# assim que o socket Wayland existir; o systemd leva-o consigo ao parar.
#
# Só ACORDA o monitor se ele já estiver ligado. O serviço reinicia sozinho a
# cada ~2 h (renovação do cookie da PVE) e o `--on` incondicional acendia o ecrã
# de madrugada com a casa a dormir. Agora, se o monitor estiver em standby fica
# em standby e o swayidle acorda-o na primeira tecla/rato; com o standby
# desligado (IDLE=0/off) acorda sempre, senão podia ficar preto sem ninguém a
# acordá-lo.
monitor_em_standby() {
    local bus modo
    bus=$(ddcutil detect --brief 2>/dev/null | awk '/I2C bus:/{print $NF; exit}')
    [ -n "$bus" ] || return 1
    modo=$(ddcutil -b "${bus#/dev/i2c-}" getvcp d6 2>/dev/null) || return 1
    case "$modo" in
        *"sl=0x01"*) return 1 ;;   # ligado
        *"sl=0x"*)   return 0 ;;   # standby / suspend / off
        *)           return 1 ;;   # sem leitura: como antes (acordar)
    esac
}

if [ "${PROX_KIOX_IDLE:-0}" = "0" ] || [ "${PROX_KIOX_IDLE:-0}" = "off" ] || ! monitor_em_standby; then
    /usr/local/bin/prox-kiox-idle --on 2>/dev/null || true
fi

if [ "${PROX_KIOX_IDLE:-0}" != "0" ] && [ "${PROX_KIOX_IDLE:-0}" != "off" ]; then
(
    WD=""
    for _ in $(seq 1 40); do
        WD=$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s -name 'wayland-*' -printf '%f\n' 2>/dev/null | head -1)
        [ -n "$WD" ] && break
        sleep 0.5
    done
    [ -n "$WD" ] || exit 0
    # O cage só anuncia idle-notify depois de criar o socket; sem esta pausa o
    # swayidle liga-se cedo demais e nunca dispara.
    sleep 3
    WAYLAND_DISPLAY="$WD" exec /usr/local/bin/prox-kiox-idle
) &
fi

# Espera pelo pveproxy: depois de um upgrade/restart da PVE o serviço pode
# arrancar antes da API responder, e o Firefox ficaria com um erro no ecrã.
if command -v curl >/dev/null 2>&1; then
    for _ in $(seq 1 60); do
        if curl -sk -o /dev/null --max-time 3 "$URL"; then break; fi
        sleep 2
    done
fi

exec cage -s -- /usr/bin/firefox-esr $ARGS "$URL"
